# Mirrors the shape of the update-channel stack env (values are dummies - the real chat
# ids, superuser list and tokens live in Portainer). Used by check-stack-config.sh to
# verify that rendering docker-compose.update-channel.yml reproduces what that bot needs.
TELEGRAM_TOKEN=dummy-telegram-token
TELEGRAM_GROUP=-100000000001
ADMIN_GROUP=-100000000002
SUPER_USER=dummy_super
OPENAI_TOKEN=dummy-openai-token
DATA_VOLUME_NAME=tg-antispam-update_ch_data-tg-spam
LOG_VOLUME_NAME=tg-antispam-update_ch_log-tg-spam
