# Mirrors the production wirenboard-chat stack env (secrets replaced with dummies).
# Used by check-stack-config.sh to verify that rendering the portainer compose file
# with this env reproduces the production configuration.
TELEGRAM_TOKEN=dummy-telegram-token
TELEGRAM_GROUP=wirenboard
ADMIN_GROUP=-1002485520426
TZ=Europe/Moscow
DISABLE_ADMIN_SPAM_FORWARD=false
DRY=false
SOFT_BAN=false
NO_SPAM_REPLY=true
OPENAI_TOKEN=dummy-openai-token
OPENAI_MODEL=gpt-5.6-sol
OPENAI_VETO=false
OPENAI_CHECK_SHORT_MESSAGES=true
SERVER_ENABLED=true
MAX_EMOJI=2
MIN_PROBABILITY=35
META_LINKS_LIMIT=1
META_MENTIONS_LIMIT=1
META_IMAGE_ONLY=true
META_LINKS_ONLY=true
META_FORWARD=true
META_KEYBOARD=true
AGGRESSIVE_CLEANUP=false
MESSAGE_SPAM=Кажется, тут был спам. Если вы человек, напишите админам и попробуйте снова.
MESSAGE_RESTORE=прошу прощения, принял вас за спамера. Вот ваше сообщение
DATA_VOLUME_NAME=tg-spam-wirenboard-chat_tg-spam-wb_data
LOG_VOLUME_NAME=tg-spam-wirenboard-chat_tg-spam-wb_log
